BOT_TOKEN=123456:ABC-your-telegram-bot-token
GEMINI_API_KEY=your-google-gemini-api-key
MAX_HISTORY_MESSAGES=12
DATABASE_PATH=data/chat_history.db
GEMINI_MODEL=gemini-2.0-flash
STREAM_EDIT_INTERVAL=1.2
GOOGLE_CREDENTIALS_PATH=credentials.json
GOOGLE_TOKEN_PATH=token.json
GOOGLE_CALENDAR_TIMEZONE=Europe/Moscow
# Optional. Use if api.telegram.org is blocked (http/https/socks5).
# TELEGRAM_PROXY=socks5://127.0.0.1:1080
# Leave SYSTEM_INSTRUCTION unset to use the built-in Jarvis butler persona.
